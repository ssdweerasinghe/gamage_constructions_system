datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("OWNER") // OWNER or ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JcbMachine {
  id             String       @id @default(uuid())
  plateNumber    String       @unique
  modelName      String
  driverName     String
  driverPhone    String
  baseMeterHours Float        @default(0.0)
  status         String       @default("ACTIVE") // ACTIVE, MAINTENANCE, IDLE
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  incomeLogs     IncomeLog[]
  expenseLogs    ExpenseLog[]
}

model IncomeLog {
  id            String          @id @default(uuid())
  jcbId         String
  jcb           JcbMachine      @relation(fields: [jcbId], references: [id], onDelete: Cascade)
  clientName    String
  siteLocation  String
  logDate       DateTime
  startTime     String          @default("08:00")
  endTime       String          @default("N/A")
  durationHours Float
  points        Float
  ratePerPoint  Float           @default(7000.0)
  totalCharge   Float
  amountPaid    Float           @default(0.0)
  paymentStatus String          @default("PENDING") // PENDING, PARTIAL, PAID
  notes         String?
  payments      PaymentRecord[]
  createdAt     DateTime        @default(now())
}

model ExpenseLog {
  id           String     @id @default(uuid())
  jcbId        String
  jcb          JcbMachine @relation(fields: [jcbId], references: [id], onDelete: Cascade)
  expenseDate  DateTime
  category     String     @default("MAINTENANCE") // FUEL, MAINTENANCE, REPAIR, SALARY, OTHER
  amount       Float
  liters       Float?
  meterReading Float?
  description  String
  createdAt    DateTime   @default(now())
}

model PaymentRecord {
  id          String    @id @default(uuid())
  incomeLogId String
  incomeLog   IncomeLog @relation(fields: [incomeLogId], references: [id], onDelete: Cascade)
  amount      Float
  paymentDate DateTime  @default(now())
  note        String?
  recordedBy  String?
  createdAt   DateTime  @default(now())
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}